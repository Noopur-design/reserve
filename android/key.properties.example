# Release signing config for Reserve (template).
#
# 1. Create your upload keystore with keytool (see DEPLOYMENT.md, step 2).
# 2. Copy this file to android/key.properties (same folder as this file).
# 3. Replace every placeholder below with your real values.
#
# android/key.properties and *.jks / *.keystore files are git-ignored.
# Never commit them, never share them, and back them up somewhere safe:
# every future update must be signed with the same upload key.
#
# When android/key.properties is missing, release builds are signed with the
# debug keys instead (fine for testing on phones, rejected by Google Play).

# Password you chose for the keystore when running keytool.
storePassword=YOUR_KEYSTORE_PASSWORD

# Password for the key itself. If you pressed RETURN at keytool's
# "Enter key password" prompt, this is the same as storePassword.
keyPassword=YOUR_KEY_PASSWORD

# The -alias you passed to keytool.
keyAlias=upload

# Full path to the .jks file. Use forward slashes (or doubled backslashes) on
# Windows. A relative path is resolved from android/app/.
storeFile=C:/Users/YOUR_WINDOWS_USER/keystores/reserve-upload.jks
